# App
PORT=5080
APP_BASE_URL=http://localhost:5080

# Maxio Advanced Billing (Basic Auth: API key as username, "X" as password)
MAXIO_API_KEY=
MAXIO_SITE=your-subdomain
MAXIO_ENVIRONMENT=US
MAXIO_PASSWORD=X
# Optional: reuse an existing product family instead of creating one
MAXIO_PRODUCT_FAMILY_ID=

# PayPal (OAuth client credentials — use Sandbox for demos)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=Sandbox
